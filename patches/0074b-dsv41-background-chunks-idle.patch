+# dsv41 patch 0074b (24.10.2026): while NO foreground request (priority below VLLM_PREFILL_THROTTLE_MIN_PRIO) runs or
+# waits, background prefill chunks share VLLM_DSV41_BG_IDLE_TOKENS per step (cap = max(LPT, that // requests)), so a
+# lone background prefill no longer crawls at LPT when nobody waits; with a foreground request present 0074 applies
+# unchanged. VLLM_DSV41_BG_IDLE_FILE (integer, 0 = off) overrides it live, read at most every 2 s. Default off.
+_DSV41_BG_IDLE_TOKENS = int(_dsv41_os.environ.get("VLLM_DSV41_BG_IDLE_TOKENS", "0") or 0)
+_DSV41_BG_IDLE_FILE = _dsv41_os.environ.get("VLLM_DSV41_BG_IDLE_FILE", "")
