+    def _dsv41_bg_idle_tokens(self) -> int:
+        """dsv41 patch 0074b: the idle budget for background chunks (VLLM_DSV41_BG_IDLE_FILE read at most
+        every 2 s, else VLLM_DSV41_BG_IDLE_TOKENS)."""
+        if not _DSV41_BG_IDLE_FILE:
+            return _DSV41_BG_IDLE_TOKENS
+        now = time.monotonic()
+        if now - getattr(self, "_dsv41_bg_idle_read", -10.0) >= 2.0:
+            self._dsv41_bg_idle_read = now
+            try:
+                with open(_DSV41_BG_IDLE_FILE) as f:
+                    self._dsv41_bg_idle_val = int(f.read().strip() or 0)
+            except (OSError, ValueError):
+                self._dsv41_bg_idle_val = _DSV41_BG_IDLE_TOKENS
+        return getattr(self, "_dsv41_bg_idle_val", _DSV41_BG_IDLE_TOKENS)
+
     def _request_remaining_blocks(self, request: Request) -> int:
