+        # dsv41 patch 0081: default max_load_tokens from the CPU tier and the groups
+        self._dsv41_load_cap: int | None = None
+        num_cpu_chunks = int(getattr(spec, "num_chunks", 0) or 0)
+        full = [g for g in self.config.kv_group_configs if g.sliding_window_size_in_chunks is None]
+        windowed = [g for g in self.config.kv_group_configs if g.sliding_window_size_in_chunks is not None]
+        chunks_per_token = sum(1.0 / g.tokens_per_chunk for g in full)
+        window_chunks = sum((g.sliding_window_size_in_chunks or 0) + 1 for g in windowed)
+        if _DSV41_LOAD_FRACTION > 0 and num_cpu_chunks > 0 and chunks_per_token > 0:
+            budget = _DSV41_LOAD_FRACTION * num_cpu_chunks - window_chunks
+            step = max(g.tokens_per_chunk for g in self.config.kv_group_configs)
+            cap = (int(max(budget, 0) / chunks_per_token) // step) * step
+            self._dsv41_load_cap = cap
+        logger.info(
+            "dsv41 patch 0081: CPU tier %d chunks; groups %s (tokens per chunk, window "
+            "chunks); %.5f chunks per token -> load cap %s tokens per request (fraction %.2f)",
+            num_cpu_chunks,
+            [(g.tokens_per_chunk, g.sliding_window_size_in_chunks) for g in self.config.kv_group_configs],
+            chunks_per_token,
+            self._dsv41_load_cap,
+            _DSV41_LOAD_FRACTION,
+        )
