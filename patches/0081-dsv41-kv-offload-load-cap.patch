 logger = init_logger(__name__)
 
+# dsv41 patch 0081: CPUs for the file-tier I/O threads, e.g. "0-4,10-14" (the A725 cores
+# on GB10, away from the X925 cores that run the launch and scheduling threads). The
+# threads otherwise inherit the process affinity; their pread/pwrite and the CRC of 0056
+# then compete with decode on the same cores. Empty = unchanged.
+_DSV41_IO_CPUS = os.environ.get("VLLM_DSV41_OFFLOAD_IO_CPUS", "").strip()
+
+
+def _dsv41_parse_cpus(spec: str) -> set[int]:
+    cpus: set[int] = set()
+    for part in spec.split(","):
+        part = part.strip()
+        if not part:
+            continue
+        if "-" in part:
+            a, b = part.split("-", 1)
+            cpus.update(range(int(a), int(b) + 1))
+        else:
+            cpus.add(int(part))
+    return cpus
+
 
