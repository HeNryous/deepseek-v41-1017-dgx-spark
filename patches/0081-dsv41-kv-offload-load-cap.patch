 logger = init_logger(__name__)
 
+# dsv41 patch 0081: per-request load cap. The tiering manager pins a chunk only when
+# the load is prepared, not when it is promoted from a secondary tier, so a prefix
+# that needs more chunks than the CPU tier holds evicts its own promoted chunks and
+# the request stays deferred forever (seen 22.10.: 76K tokens against 963 chunks,
+# EngineCore at 100 % CPU, the request never scheduled). With a fraction > 0 every
+# request loads at most what fits that share of the CPU tier; the rest is computed.
+_DSV41_LOAD_FRACTION = float(os.environ.get("VLLM_DSV41_OFFLOAD_LOAD_FRACTION", "0") or 0)
