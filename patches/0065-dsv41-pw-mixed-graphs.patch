+def _piecewise() -> bool:
+    """dsv41 patch 0065: whether this forward runs as a breakable PIECEWISE graph (capture or replay)."""
+    global _in_pw
+    if _in_pw is None:
+        try:
+            from vllm.forward_context import in_piecewise_cudagraph as f
+        except ImportError:  # an image without breakable graphs: never PIECEWISE here
+            def f() -> bool:
+                return False
+        _in_pw = f
+    return _in_pw()
+
