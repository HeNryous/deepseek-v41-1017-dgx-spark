 logger = init_logger(__name__)
 
 
+# dsv41 patch 0065: PIECEWISE (breakable) CUDA graphs for mixed prefill + decode steps, bounded. Only active when the
+# cudagraph mode has a PIECEWISE mixed routine (FULL_AND_PIECEWISE); FULL_DECODE_ONLY serves exactly as before.
+#   VLLM_DSV41_PW_SIZES     comma list of token counts that get a PIECEWISE graph; empty = every cudagraph_capture_sizes
+#                           entry (upstream). The FULL decode graphs keep cudagraph_capture_sizes either way.
+#   VLLM_DSV41_PW_MAX_ROWS  PIECEWISE graphs above this many tokens are dropped. Default: the EXL3 MoE plugin's coop
+#                           limit (VLLM_EXL3_MOE_COOP_MAX_TOKENS, else the config's 32; at most 42 = 256 slots / top-k 6),
+#                           because above it the plugin captures exl3_moe with fp32 atomics (vllm_exl3_moe/forward.py:
+#                           not bit-reproducible, other rounding than the eager paths). 0 = no limit.
+#   VLLM_DSV41_PW_TWINS     short-context twins (short_ctx.py) of the PIECEWISE graphs too: bounds out of
+#                           VLLM_SHORT_CTX_BOUNDS as a comma list, "1" = all of them, empty / "0" = none. Without them a
+#                           captured mixed step scores the indexer where the eager step takes the short branch (same
+#                           entries in another order: rounding only, T=0 texts can differ from eager).
+def _dsv41_env_ints(name: str) -> list[int]:
+    raw = os.environ.get(name, "").replace(" ", "")
+    return sorted({int(x) for x in raw.split(",") if x})
+
+
+def dsv41_pw_max_rows() -> int:
+    raw = os.environ.get("VLLM_DSV41_PW_MAX_ROWS", "").strip()
+    if raw:
+        return max(0, int(raw))
+    coop = int(os.environ.get("VLLM_EXL3_MOE_COOP_MAX_TOKENS", "").strip() or 32)
+    return max(1, min(coop, 42))
+
+
+def dsv41_pw_sizes(capture_sizes: Iterable[int], max_tokens: int) -> list[int]:
+    """Token counts that get a PIECEWISE graph: VLLM_DSV41_PW_SIZES (else the capture sizes), within the cap."""
+    sizes = _dsv41_env_ints("VLLM_DSV41_PW_SIZES") or sorted(set(capture_sizes))
+    cap = dsv41_pw_max_rows()
+    keep = [s for s in sizes if 0 < s <= max_tokens and (cap == 0 or s <= cap)]
+    dropped = [s for s in sizes if s not in keep]
+    if dropped:
+        logger.warning(
+            "dsv41 0065: no PIECEWISE graph for %s tokens (cap %s rows, max %d tokens; "
+            "VLLM_DSV41_PW_MAX_ROWS)", dropped, cap or "none", max_tokens,
+        )
+    return keep
+
+
+def dsv41_pw_twin_bounds() -> list[int]:
+    """Context bounds of the PIECEWISE short-context twins (VLLM_DSV41_PW_TWINS)."""
+    raw = os.environ.get("VLLM_DSV41_PW_TWINS", "").replace(" ", "")
+    if raw in ("", "0"):
+        return []
+    if raw == "1":
+        return list(short_ctx.BOUNDS)
+    want = {int(x) for x in raw.split(",") if x}
+    return [b for b in short_ctx.BOUNDS if b in want]
+
