+    def dsv41_release_if_due(self) -> None:
+        """dsv41 patch 0085b: called by the engine core on every rank when it goes idle. If at least the
+        threshold of prefill tokens ran since the last release, give the allocator's unused cache back once."""
+        try:
+            self._dsv41_release_if_due()
+        except Exception as e:  # noqa: BLE001  (never raise: a FAILURE reply would desync collective_rpc)
+            logger.warning("dsv41 patch 0085b: release failed: %r", e)
+
+    def _dsv41_release_if_due(self) -> None:
+        threshold = _DSV41_RELEASE_TOKENS
+        if _DSV41_RELEASE_FILE:
+            try:
+                with open(_DSV41_RELEASE_FILE) as f:
+                    threshold = int(f.read().strip() or 0)
+            except (OSError, ValueError):
+                pass
+        since = getattr(self, "_dsv41_prefill_since_release", 0)
+        if threshold <= 0 or since < threshold:
+            return
+        self._dsv41_prefill_since_release = 0
+        t0 = time.monotonic()
+        torch.cuda.synchronize()
+        before = torch.cuda.memory_reserved()
+        torch.accelerator.empty_cache()
+        after = torch.cuda.memory_reserved()
+        logger.info(
+            "dsv41 patch 0085b: idle, after %d prefill tokens released %.0f MiB of cached memory "
+            "(reserved %.0f -> %.0f MiB) in %.1f ms",
+            since, (before - after) / 2**20, before / 2**20, after / 2**20, (time.monotonic() - t0) * 1e3,
+        )
+
