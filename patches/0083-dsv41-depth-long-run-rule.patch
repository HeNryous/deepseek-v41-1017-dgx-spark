+def choose_depth_lam(
+    confidence_probs: torch.Tensor, cost_ms: torch.Tensor, lam: torch.Tensor
+) -> torch.Tensor:
+    """0083: [n, k] acceptance probabilities, cost by depth, [n] stream rates (tokens per ms) -> [n] int32 depths
+    maximizing (1 + sum of survivals) - lam * cost."""
+    conf = confidence_probs.float().clamp(0.0, 1.0)
+    survival = torch.cumprod(conf, dim=1)
+    expected = torch.cat(
+        (torch.ones_like(conf[:, :1]), 1.0 + torch.cumsum(survival, dim=1)), dim=1
+    )
+    # argmax keeps the first (shallowest) depth among equal values.
+    return torch.argmax(expected - lam[:, None] * cost_ms[None, :], dim=1).to(torch.int32)
+
