+    def _ctx_extra(self, seq_lens: torch.Tensor | None, n: int) -> torch.Tensor | float:
+        """Sum over the step's requests of the context cost (ms), 0 without "ctx"."""
+        if self._ctx_x is None or seq_lens is None:
+            return 0.0
+        L = seq_lens[:n].float()
+        x, y = self._ctx_x, self._ctx_y
+        i = torch.searchsorted(x, L).clamp(1, max(1, x.numel() - 1))
+        if x.numel() == 1:
+            v = y.expand_as(L)
+        else:
+            x0, x1, y0, y1 = x[i - 1], x[i], y[i - 1], y[i]
