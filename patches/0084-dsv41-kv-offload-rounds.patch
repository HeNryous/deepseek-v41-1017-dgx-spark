+    def _dsv41_probe(self, req_status: RequestOffloadState) -> LookupResult:
+        """Would the request's lookup promote from a secondary tier? Asks the manager without promoting
+        (TieringOffloadingManager.dsv41_probe_offloaded) for the keys of the first lookup group from the
+        computed prefix up to the load cap. Managers without the probe (no tiering) cannot promote: MISS."""
+        probe = getattr(self.manager, "dsv41_probe_offloaded", None)
+        if probe is None or not self._lookup_groups:
+            return LookupResult.MISS
+        group_idx = self._lookup_groups[0]
+        tokens_per_chunk = self.config.kv_group_configs[group_idx].tokens_per_chunk
+        keys = req_status.group_states[group_idx].offload_keys
+        local = req_status.num_locally_computed_tokens
+        end_tokens = req_status.req.num_tokens
+        if req_status.max_load_tokens is not None:
+            end_tokens = min(end_tokens, local + req_status.max_load_tokens)
+        start = local // tokens_per_chunk
+        end = min(len(keys), end_tokens // tokens_per_chunk)
