+    def _dsv41_holds(self, req_id: ReqId) -> bool:
+        """Whether the request has offload work in flight, from live state only: an async load not yet
+        finished, 0084 follow-up rounds pending, or (not running) a last lookup that was deferred by the
+        backend (promotions) or hit chunks not yet loaded."""
+        if not self._dsv41_alive(req_id):
+            return False
+        req_status = self._req_status[req_id]
+        request = req_status.req
+        if self._dsv41_has_load_job(req_status) or getattr(request, "dsv41_load_more", False):
+            return True
+        if request.status == RequestStatus.RUNNING:
+            return False
+        return req_status.dsv41_last_hit != 0
