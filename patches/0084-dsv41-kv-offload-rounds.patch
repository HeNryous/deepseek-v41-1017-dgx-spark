+        # in flight already (incl. 0084 follow-up rounds), or gave up waiting: never blocked
+        if getattr(request, "dsv41_load_more", False) or req_status.dsv41_gave_up:
+            return True
+        if rid in self._dsv41_holders and self._dsv41_holds(rid):
+            return True
+        now = time.monotonic()
+        inflight = self._dsv41_inflight()
+        free = self._dsv41_max_loads - inflight
+        if free > 0:
+            rank = (request.priority, request.arrival_time)
+            ahead = sum(
+                1
+                for w, w_rank in self._dsv41_waiters.items()
+                if w != rid and w_rank < rank and self._dsv41_alive(w)
+            )
+            if ahead < free:
+                self._dsv41_holders.add(rid)
+                req_status.dsv41_last_hit = None  # holds the slot until its lookup says otherwise
+                if self._dsv41_waiters.pop(rid, None) is not None:
+                    logger.info(
+                        "dsv41 patch 0084 v26h: request %s admitted after %.1f s (in flight before: %d of %d)",
+                        rid, now - (req_status.dsv41_wait_since or now), inflight, self._dsv41_max_loads,
+                    )
+                return True
+        verdict = self._dsv41_probe(req_status)
+        if verdict is LookupResult.MISS:
+            # nothing to promote (fresh prompt, or CPU-tier hits only): never waits
+            if self._dsv41_waiters.pop(rid, None) is not None:
+                logger.info(
+                    "dsv41 patch 0084 v26h: request %s stops waiting after %.1f s: nothing left to promote "
+                    "(in flight: %d of %d)",
+                    rid, now - (req_status.dsv41_wait_since or now), inflight, self._dsv41_max_loads,
+                )
+            return True
+        if req_status.dsv41_wait_since is None:
+            req_status.dsv41_wait_since = now
+        waited = now - req_status.dsv41_wait_since
+        if waited >= _DSV41_ADMIT_WAIT_S:
+            req_status.dsv41_gave_up = True
+            self._dsv41_waiters.pop(rid, None)
+            logger.warning(
+                "dsv41 patch 0084 v26h: request %s gives up waiting for a slot after %.1f s (in flight: %d of "
+                "%d); CPU-tier hits or compute, as without admission control",
+                rid, waited, inflight, self._dsv41_max_loads,
+            )
+            return True
+        if rid not in self._dsv41_waiters:
+            logger.info(
+                "dsv41 patch 0084 v26h: request %s waits for a slot (next chunk %s; in flight: %d of %d; "
+                "waited so far %.1f s of %.0f s)",
