+    # ---- dsv41 patch 0084 v26h: admission control before promotion ------------------------------------------
+    def _dsv41_alive(self, req_id: ReqId) -> bool:
+        req_status = self._req_status.get(req_id)
+        return (
+            req_status is not None
+            and not req_status.finished_signaled
+            and not req_status.req.is_finished()
