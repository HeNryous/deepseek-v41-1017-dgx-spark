+            if manager.max_admission_blocks_per_request is not None:
+                full_blocks = min(full_blocks, manager.max_admission_blocks_per_request)
+            need_full += max(full_blocks - held, 0)
+            need_step += max(cdiv(step_tokens, manager.block_size) - held, 0)
