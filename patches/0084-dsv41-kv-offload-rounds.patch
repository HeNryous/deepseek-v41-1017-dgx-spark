+    def _dsv41_round_fit(
+        self, request: Request, target: int, reserved: int
+    ) -> tuple[bool, str] | None:
+        """dsv41 patch 0084 (v26e): whether the round loading [num_computed_tokens, target)
+        gets its slots, without changing anything.
+
+        Mirrors allocate_slots as it runs after _dsv41_prepare_round: remove_skipped_blocks
+        frees the non-null run below each manager's skip boundary (read backwards, as
+        _remove_blocks_in_range does; a block returns to the pool only at ref_cnt 0), the
+        block table is padded with nulls up to the target's skip boundary, and a request the
+        manager already tracks takes the fast path of get_num_blocks_to_allocate: the blocks
+        between the padded length and the target (step check, against free - reserved) or the
+        full sequence capped by the admission cap (full-ISL gate, against free). Both checks
+        add the watermark as allocate_slots does. Returns (fits, numbers for the log), or
+        None if a manager is not one this mirror covers (the caller then ends the rounds).
+        """
+        from vllm.v1.core.single_type_kv_cache_manager import (
+            CircularBufferManager,
+            FullAttentionManager,
+            SlidingWindowManager,
+        )
+
+        rid = request.request_id
+        pool = self.kv_cache_manager.block_pool
+        full_tokens = min(request.num_tokens, self.max_model_len)
+        step_tokens = min(target, self.max_model_len)
+        processed = max(0, step_tokens - request.num_in_flight_tokens)
+        need_full = need_step = released = 0
+        for manager in self.kv_cache_manager.coordinator.single_type_managers:
+            if isinstance(manager, CircularBufferManager):
+                # one ring block for the request's lifetime, claimed by its first round
+                n = manager.get_num_blocks_to_allocate(
+                    rid,
+                    step_tokens,
+                    (),
+                    step_tokens,
+                    request.num_computed_tokens,
+                    step_tokens,
+                )
+                need_full += n
+                need_step += n
+                continue
+            if (
+                type(manager) not in (FullAttentionManager, SlidingWindowManager)
+                or rid not in manager.num_cached_block
+            ):
+                if not getattr(self, "_dsv41_fit_warned", False):
+                    self._dsv41_fit_warned = True
+                    logger.warning(
+                        "dsv41 patch 0084: KV cache manager %s (tracks %s: %s) is not "
+                        "covered by the round check; prefixes over the load cap are "
+                        "computed after the first load instead",
+                        type(manager).__name__,
+                        rid,
+                        rid in manager.num_cached_block,
+                    )
+                return None
+            blocks = manager.req_to_blocks.get(rid, ())
